    <section{% if block.anchor | safeAnchor %} id="{{ block.anchor | safeAnchor }}"{% endif %}{% cms blockRef, blockKind %}>
      <div class="container">
        {% if block.heading %}<h2 class="section-title" style="text-align: center;"{% cms blockRef + ".heading", "text" %}>{{ block.heading }}</h2>{% endif %}
        <div class="faq-list">
          {%- for item in block.items %}
          <div class="faq-item open"{% cms blockRef + ".items." + loop.index0, "item" %}>
            <div class="faq-q" style="cursor: default;"{% cms blockRef + ".items." + loop.index0 + ".q", "text" %}>{{ item.q }}</div>
            <div class="faq-a" style="max-height: none;"><div class="faq-a-inner"{% cms blockRef + ".items." + loop.index0 + ".a", "longtext" %}>{{ item.a }}</div></div>
          </div>
          {%- endfor %}
        </div>
      </div>
    </section>
