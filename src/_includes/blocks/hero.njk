    <section class="hero"{% if block.anchor | safeAnchor %} id="{{ block.anchor | safeAnchor }}"{% endif %} style="padding: 5rem 0 3rem;"{% cms blockRef, blockKind %}>
      <div class="container hero-inner">
        <h1{% cms blockRef + ".heading", "text" %}>{{ block.heading }}{% if block.accent %} <span class="accent"{% cms blockRef + ".accent", "text" %}>{{ block.accent }}</span>{% endif %}</h1>
        {% if block.sub %}<p class="hero-sub"{% cms blockRef + ".sub", "longtext" %}>{{ block.sub }}</p>{% endif %}
        {% if block.ctaText %}<div class="hero-ctas"><a href="{{ block.ctaLink | safeUrl }}" class="btn btn-primary"{% cms blockRef + ".ctaText", "text", { href: blockRef + ".ctaLink" } %}>{{ block.ctaText }}</a></div>{% endif %}
      </div>
    </section>
