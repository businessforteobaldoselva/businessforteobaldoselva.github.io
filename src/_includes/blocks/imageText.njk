    {%- set blockImg = block.image | imageInfo %}
    {%- import "picture.njk" as pic %}
    <section{% if block.anchor | safeAnchor %} id="{{ block.anchor | safeAnchor }}"{% endif %}{% cms blockRef, blockKind %}>
      <div class="container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 3rem; align-items: center;">
        {% if not block.imageRight %}
        <figure class="polaroid" style="--tilt: -2deg; max-width: 420px;"{% cms blockRef + ".imageRight", "toggle" %}>
          {{ pic.picture(blockImg, block.alt, block.decorative, "(max-width: 780px) 92vw, 420px", false, blockRef + ".image", blockRef + ".alt", blockRef + ".decorative") }}
          {% if block.caption %}<figcaption{% cms blockRef + ".caption", "text" %}>{{ block.caption }}</figcaption>{% endif %}
        </figure>
        {% endif %}
        <div>
          {% if block.heading %}<h2 class="section-title"{% cms blockRef + ".heading", "text" %}>{{ block.heading }}</h2>{% endif %}
          <div class="section-sub"{% cms blockRef + ".body", "markdown" %}>{{ block.body | md | safe }}</div>
        </div>
        {% if block.imageRight %}
        <figure class="polaroid" style="--tilt: 2deg; max-width: 420px;"{% cms blockRef + ".imageRight", "toggle" %}>
          {{ pic.picture(blockImg, block.alt, block.decorative, "(max-width: 780px) 92vw, 420px", false, blockRef + ".image", blockRef + ".alt", blockRef + ".decorative") }}
          {% if block.caption %}<figcaption{% cms blockRef + ".caption", "text" %}>{{ block.caption }}</figcaption>{% endif %}
        </figure>
        {% endif %}
      </div>
    </section>
