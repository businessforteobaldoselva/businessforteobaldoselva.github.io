    <section{% if block.anchor | safeAnchor %} id="{{ block.anchor | safeAnchor }}"{% endif %}{% cms blockRef, blockKind %}>
      <div class="container">
        {% if block.kicker %}<span class="kicker"{% cms blockRef + ".kicker", "text" %}>{{ block.kicker }}</span>{% endif %}
        {% if block.heading %}<h2 class="section-title"{% cms blockRef + ".heading", "text" %}>{{ block.heading }}</h2>{% endif %}
        <div class="section-sub" style="max-width: 66ch;"{% cms blockRef + ".body", "markdown" %}>{{ block.body | md | safe }}</div>
      </div>
    </section>
