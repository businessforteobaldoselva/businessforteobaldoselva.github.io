{% set pageTitle = (site.subpageTitle or "{title}") | replace("{title}", title or "") %}{% set shareImg = site.shareImage | imageInfo %}{% set shareSrc = (shareImg.src if shareImg.src.charAt(0) == "/" else "/" + shareImg.src) if shareImg.src else "" %}<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ pageTitle }}</title>
  {% if description %}<meta name="description" content="{{ description }}" />{% endif %}
  <meta property="og:title" content="{{ pageTitle }}" />
  {% if description %}<meta property="og:description" content="{{ description }}" />{% endif %}
  {% if shareSrc %}<meta property="og:image" content="https://coveredaccess.com{{ shareSrc }}" />{% endif %}
  <link rel="canonical" href="https://coveredaccess.com{{ page.url }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://coveredaccess.com{{ page.url }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="{{ theme.paper2 | safeColor("#FFEFDA") }}" />
  <link rel="alternate" type="application/atom+xml" title="{{ site.feedTitle }}" href="/feed.xml" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Cpath fill='%2394AB8D' d='M31 8C36.5 17 44 22.5 44 33A13 13 0 1 1 18 33C18 22.5 25.5 17 31 8Z'/%3E%3Ccircle cx='15' cy='15' r='11' fill='%23F0A35C'/%3E%3C/svg%3E" />
  <link rel="preload" href="/fonts/motor-regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/open-sauce-one-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/assets/site.css" />
</head>
<body>

  {% include "chrome/skip-link.njk" %}

  {% include "chrome/nav.njk" %}

  <main id="top">
    {%- for block in sections %}

      {%- if block.type == "hero" %}
{% include "blocks/hero.njk" %}

      {%- elif block.type == "text" %}
{% include "blocks/text.njk" %}

      {%- elif block.type == "imageText" %}
{% include "blocks/imageText.njk" %}

      {%- elif block.type == "stats" %}
{% include "blocks/stats.njk" %}

      {%- elif block.type == "banner" %}
{% include "blocks/banner.njk" %}

      {%- elif block.type == "faq" %}
{% include "blocks/faq.njk" %}
      {%- endif %}

    {%- endfor %}
  </main>

  {% include "chrome/footer.njk" %}

  <script>
    /* Brand period: colour the final full stop of display lines (see index). */
    (function () {
      document.querySelectorAll(".section-title, .hero h1").forEach(function (el) {
        if (el.querySelector(".brand-period")) return;
        var walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null);
        var lastText = null, node;
        while ((node = walker.nextNode())) { if (node.textContent.trim()) lastText = node; }
        if (!lastText) return;
        if (lastText.textContent.replace(/\s+$/, "").slice(-1) !== ".") return;
        var idx = lastText.textContent.lastIndexOf(".");
        var tail = lastText.splitText(idx);
        tail.textContent = tail.textContent.slice(1);
        var dot = document.createElement("span");
        dot.className = "brand-period";
        dot.textContent = ".";
        lastText.parentNode.insertBefore(dot, tail);
      });
    })();
  </script>
</body>
</html>
