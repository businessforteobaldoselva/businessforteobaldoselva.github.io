{% import "forms/enquiry-form.njk" as ef %}
{% import "picture.njk" as pic %}
    <!-- ============ FOR BRANDS ============ -->
    <section id="brands" class="dark" aria-labelledby="brands-title">
      <div class="container">
        <div class="reveal brands-head">
          <div>
            <span class="kicker">{{ brands.kicker }}</span>
            <h2 class="section-title" id="brands-title">{{ brands.title | safeTitle | safe }}</h2>
            <p class="section-sub">
              {{ brands.subtitle }}
            </p>
          </div>
          <figure class="polaroid">
            {%- set video = brands.headerPhoto.video | siteMediaPath %}
            {%- if video %}
            <video class="polaroid-video" src="{{ video }}"{% if brands.headerPhoto.poster | siteMediaPath %} poster="{{ brands.headerPhoto.poster | siteMediaPath }}"{% endif %}
                   muted playsinline loop preload="metadata" data-autoplay
                   aria-label="{{ brands.headerPhoto.alt }}"></video>
            {%- else %}
            {%- set im = brands.headerPhoto.src | imageInfo %}
            {%- if im.src %}
            {{ pic.picture(im, brands.headerPhoto.alt, brands.headerPhoto.decorative, "250px") }}
            {%- endif %}
            {%- endif %}
            <figcaption>{{ brands.headerPhoto.caption }}</figcaption>
          </figure>
        </div>

        <div class="benefit-grid">
          {%- for b in brands.benefits %}
          <div class="benefit reveal">
            <div class="b-icon" aria-hidden="true">{{ ic.emojiIcon(b.icon) }}</div>
            <h3>{{ b.title }}</h3>
            <p>{{ b.desc }}</p>
          </div>
          {%- endfor %}
        </div>

        <div class="chip-row reveal">
          {%- for chip in brands.chips %}
          <span class="chip">{{ chip }}</span>
          {%- endfor %}
        </div>

        <div class="form-card reveal">
          <h3>{{ brands.form.heading }}</h3>
          {{ ef.enquiryForm("brandForm", "brand-enquiry", brands.form, "bf") }}
        </div>
      </div>
    </section>
