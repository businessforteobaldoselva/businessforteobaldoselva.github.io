    <!-- ============ CTA ============ -->
    <section{% if sectionData.ariaLabel %} aria-label="{{ sectionData.ariaLabel }}"{% endif %}{% cms blockRef, blockKind %}>
      <div class="container">
        {#- Brand ident: the "covered." sting (Kling generation, local trial).
            Plays once when it scrolls into view; click/tap replays.
            The video file and its cover picture come from the cta entry in
            homepage.json (sectionData.video); the picture also supplies the
            width/height. No video, no ident block. -#}
        {%- set identSrc = sectionData.video.src | storyVideo %}
        {%- if identSrc %}
        {%- set identPoster = sectionData.video.poster | imageInfo -%}
        <div class="ident-video reveal">
          <video id="identVideo"
                 src="{{ identSrc }}"
                 {% if identPoster.src %}poster="{{ identPoster.src }}"{% endif %}
                 muted playsinline preload="metadata"
                 {% if identPoster.width and identPoster.height %}width="{{ identPoster.width }}" height="{{ identPoster.height }}"{% endif %}
                 {% if sectionData.videoLabel %}aria-label="{{ sectionData.videoLabel }}"{% endif %}></video>
        </div>
        <script>
          (function () {
            "use strict";
            var v = document.getElementById("identVideo");
            if (!v) { return; }
            var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            if (!reduced && "IntersectionObserver" in window) {
              var seen = false;
              var io = new IntersectionObserver(function (entries) {
                entries.forEach(function (en) {
                  if (en.isIntersecting && !seen) {
                    seen = true;
                    v.play().catch(function () {});
                    io.unobserve(v);
                  }
                });
              }, { threshold: 0.6 });
              io.observe(v);
            }
            v.addEventListener("click", function () {
              v.currentTime = 0;
              v.play().catch(function () {});
            });
          })();
        </script>
        {%- endif %}
        <div class="cta-banner reveal"{% cms "theme.ink", "color", { cssvar: "--ink" } %}>
          <h2{% cms "site.ctaBannerTitle", "text" %}>{{ site.ctaBannerTitle }}</h2>
          <p{% cms "site.ctaBannerText", "longtext" %}>{{ site.ctaBannerText }}</p>
          <a class="btn btn-light" href="mailto:{{ site.contactEmail }}{% if sectionData.emailSubject %}?subject={{ sectionData.emailSubject | ctaMailtoSubject }}{% endif %}"{% cms "site.ctaBannerButton", "text" %}>{{ site.ctaBannerButton }}</a>
        </div>
      </div>
    </section>
