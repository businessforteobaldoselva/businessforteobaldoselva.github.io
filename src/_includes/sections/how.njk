{% import "picture.njk" as pic %}
    <!-- ============ HOW IT WORKS / DEMO ============ -->
    <section id="how" aria-labelledby="how-title">
      <div class="container">
        <div class="reveal" style="text-align:center;">
          <span class="kicker">{{ how.kicker }}</span>
          <h2 class="section-title" id="how-title">{{ how.title }}</h2>
          <p class="section-sub" style="margin: 0 auto;">
            {{ how.subtitle }}
          </p>
        </div>

        {%- if how.story and how.story.length %}
        <div class="story-strip reveal" role="list" aria-label="{{ how.storyLabel }}">
          {%- for s in how.story %}
          {%- set im = s.src | imageInfo %}
          <figure class="story-card" role="listitem">
            {%- if im.src %}
            {{ pic.picture(im, s.alt, s.decorative, "(max-width: 780px) 46vw, 270px") }}
            {%- endif %}
            <figcaption><strong>{{ s.title }}</strong><span>{{ s.caption }}</span></figcaption>
          </figure>
          {%- endfor %}
        </div>
        {%- endif %}

        <ol class="stepper reveal" id="stepper" aria-label="{{ how.demo.stepperLabel }}">
          <li class="step-chip active" data-step="0" aria-current="step"><span class="n" aria-hidden="true">1</span> {{ how.demo.scan.chip }}</li>
          <li class="step-chip" data-step="1"><span class="n" aria-hidden="true">2</span> {{ how.demo.checkIn.chip }}</li>
          <li class="step-chip" data-step="2"><span class="n" aria-hidden="true">3</span> {{ how.demo.sponsor.chip }}</li>
          <li class="step-chip" data-step="3"><span class="n" aria-hidden="true">4</span> {{ how.demo.done.chip }}</li>
        </ol>

        <div class="demo-card reveal">
          <!-- Machine -->
          <div class="machine-stage" id="machineStage">
            <div class="machine" role="img" aria-label="{{ how.demo.machine.ariaLabel }}">
              <span class="led" aria-hidden="true"></span>
              <div class="m-screen" id="machineScreen">
                <div class="qr" aria-hidden="true"></div>
              </div>
              <div class="m-label">{{ how.demo.machine.label }}</div>
              <div class="m-slot" id="machineSlot">
                <div class="pack" id="pack">{{ how.demo.machine.packText }}</div>
              </div>
            </div>
            <span class="stamp machine-stamp" id="machineStamp">{{ how.demo.machine.stamp }}</span>
          </div>

          <!-- Phone -->
          <div class="phone">
            <div class="p-screen" id="phoneScreen" aria-live="polite" tabindex="-1">
              <h3>{{ how.demo.scan.title }}</h3>
              <p>{{ how.demo.scan.text }}</p>
              <button class="btn btn-primary" id="btnScan">{{ how.demo.scan.button }}</button>
            </div>
          </div>
        </div>

        <p class="demo-note">
          {{ how.demoNote }}
        </p>
      </div>
    </section>
