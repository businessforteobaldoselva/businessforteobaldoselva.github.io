    <!-- ============ LOCATIONS ============ -->
    <section id="locations" aria-labelledby="locations-title"{% cms blockRef, blockKind %}>
      <div class="container">
        <div class="reveal" style="text-align:center;">
          <span class="kicker"{% cms "locations.kicker", "text" %}>{{ locations.kicker }}</span>
          <h2 class="section-title" id="locations-title"{% cms "locations.title", "text" %}>{{ locations.title | safeTitle | safe }}</h2>
          <p class="section-sub" style="margin: 0 auto;"{% cms "locations.subtitle", "longtext" %}>
            {{ locations.subtitle }}
          </p>
        </div>

        <div class="loc-grid">
          <div class="uk-map-wrap reveal">
            <svg class="uk-map" viewBox="{{ locations.svgViewBox }}" role="img" aria-label="{{ locations.svgAriaLabel }}">
              <defs>
                <radialGradient id="pinLive" cx="0.35" cy="0.3" r="0.9">
                  <stop offset="0%" stop-color="#FF9A63"/>
                  <stop offset="55%" stop-color="#FC7130"/>
                  <stop offset="100%" stop-color="#B44A10"/>
                </radialGradient>
                <radialGradient id="pinSoon" cx="0.35" cy="0.3" r="0.9">
                  <stop offset="0%" stop-color="#FFFFFF"/>
                  <stop offset="70%" stop-color="#FFF3E2"/>
                  <stop offset="100%" stop-color="#E4CBA4"/>
                </radialGradient>
                <filter id="pinShadow" x="-40%" y="-40%" width="180%" height="180%">
                  <feDropShadow dx="0" dy="1.4" stdDeviation="1.6" flood-color="#1C3110" flood-opacity="0.35"/>
                </filter>
              </defs>
              {%- set mapIm = locations.mapImage | imageInfo %}
              {%- if mapIm.src %}
              {%- set mapSrc = mapIm.src if mapIm.src.startsWith("/") else "/" + mapIm.src %}
              {%- set mapBox = (locations.svgViewBox | default("")).split(" ") %}
              <image href="{{ mapSrc }}" x="0" y="0" width="{{ mapBox[2] or mapIm.width }}" height="{{ mapBox[3] or mapIm.height }}"{% cms "locations.mapImage", "image" %} />
              {%- else %}
              <path class="uk-neighbor" d="{{ locations.neighborPath }}"/>
              <path class="uk-land" d="{{ locations.landPath }}"/>
              {%- endif %}
              <g id="mapPins" aria-hidden="true"></g>
            </svg>
            <div class="map-legend" aria-hidden="true">
              <span{% cms "locations.labels.legendLive", "text" %}><span class="dot live"></span>{{ locations.labels.legendLive }}</span>
              <span{% cms "locations.labels.legendSoon", "text" %}><span class="dot soon"></span>{{ locations.labels.legendSoon }}</span>
            </div>
          </div>

          <div class="reveal">
            <div class="city-chips" id="cityChips" role="group" aria-label="{{ locations.labels.cityPickerAriaLabel }}"></div>
            <div class="city-detail" id="cityDetail" aria-live="polite"></div>
            <div class="loc-types">
              <p class="loc-types-title"{% cms "locations.placeTypesTitle", "text" %}>{{ locations.placeTypesTitle }}</p>
              <div class="chip-row">
                {%- for pt in locations.placeTypes %}
                <span class="chip"{% cms "locations.placeTypes." + loop.index0, "item" %}>{{ ic.emojiIcon(pt.emoji) }} {{ pt.label }}</span>
                {%- endfor %}
              </div>
              {%- if homepage | sectionEnabled("venues") %}
              <p class="loc-cta">
                <a href="#venues" class="btn btn-outline"{% cms "locations.ctaButton", "text" %}>{{ locations.ctaButton }}</a>
              </p>
              {%- endif %}
            </div>
          </div>
        </div>
      </div>
    </section>
