    <!-- ============ MODEL ============ -->
    <section class="model-band texture-dots" aria-labelledby="model-title"{% cms blockRef, blockKind %}>
      <div class="container">
        <div class="reveal" style="text-align:center;">
          <span class="kicker"{% cms "model.kicker", "text" %}>{{ model.kicker }}</span>
          <h2 class="section-title" id="model-title"{% cms "model.title", "text" %}>{{ model.title }}</h2>
          <p class="section-sub" style="margin: 0 auto;"{% cms "model.subtitle", "longtext" %}>
            {{ model.subtitle }}
          </p>
        </div>

        <div class="loop reveal">
          {%- for step in model.steps %}
          <div class="loop-step"{% cms "model.steps." + loop.index0, "item" %}>
            <div class="loop-emoji" aria-hidden="true">{{ ic.emojiIcon(step.emoji) }}</div>
            <h3{% cms "model.steps." + loop.index0 + ".title", "text" %}>{{ step.title }}</h3>
            <p{% cms "model.steps." + loop.index0 + ".desc", "longtext" %}>{{ step.desc }}</p>
          </div>
          {%- if not loop.last %}<div class="loop-arrow" aria-hidden="true"{% cms "model.loopArrow", "text" %}>{{ model.loopArrow }}</div>{% endif %}
          {%- endfor %}
        </div>

        {%- if model.belt.words and model.belt.words.length %}
        <div class="conveyor reveal" aria-hidden="true"{% cms "motion.conveyor", "toggle" %}>
          <div class="belt-track">
            {% for word in model.belt.words | storyRepeat(model.belt.repeats) %}<span class="belt-pack">{{ word }}</span>{% endfor %}
          </div>
        </div>
        {%- endif %}

        <div class="model-visual reveal">
          {%- set vsrc = model.video.src | storyVideo %}
          {%- if vsrc %}
          {%- set vposter = model.video.poster | imageInfo %}
          <figure class="model-photo">
            <video class="model-video" src="{{ vsrc }}"{% if vposter.src %} poster="{{ vposter.src }}"{% endif %}
                   muted playsinline preload="metadata"{% if vposter.width and vposter.height %} width="{{ vposter.width }}" height="{{ vposter.height }}"{% endif %} data-autoplay
                   aria-label="{{ model.video.label }}"></video>
          </figure>
          {%- endif %}

          {#- Every part of the receipt is optional: it shows the parts that are
              filled in, and with all of them empty it is not rendered at all. -#}
          {%- set rc = model.receipt or {} %}
          {%- set rcRows = rc.rows or [] %}
          {%- if rc.brand or rc.meta or rcRows.length or rc.total.label or rc.total.value or rc.paid or rc.script %}
          <aside class="receipt"{% if rc.ariaLabel %} aria-label="{{ rc.ariaLabel }}"{% endif %}>
            {%- if rc.brand %}
            <p class="r-brand"{% cms "model.receipt.brand", "text" %}>{{ rc.brand }}<span class="brand-period">.</span></p>
            {%- endif %}
            {%- if rc.meta %}
            <p class="r-meta"{% cms "model.receipt.meta", "text" %}>{{ rc.meta }}</p>
            {%- endif %}
            {%- for row in rcRows %}
            <div class="r-row"{% cms "model.receipt.rows." + loop.index0, "item" %}><span{% cms "model.receipt.rows." + loop.index0 + ".label", "text" %}>{{ row.label }}</span><span{% cms "model.receipt.rows." + loop.index0 + ".value", "text" %}>{{ row.value }}</span></div>
            {%- endfor %}
            {%- if rc.total.label or rc.total.value %}
            <div class="r-row r-total"><span{% cms "model.receipt.total.label", "text" %}>{{ rc.total.label }}</span><span{% cms "model.receipt.total.value", "text" %}>{{ rc.total.value }}</span></div>
            {%- endif %}
            {%- if rc.paid %}
            <p class="r-paid"{% cms "model.receipt.paid", "text" %}>{{ rc.paid }}</p>
            {%- endif %}
            <div class="r-code" aria-hidden="true"></div>
            {%- if rc.script %}
            <p class="r-script"{% cms "model.receipt.script", "text" %}>{{ rc.script }}</p>
            {%- endif %}
          </aside>
          {%- endif %}
        </div>
      </div>
    </section>
