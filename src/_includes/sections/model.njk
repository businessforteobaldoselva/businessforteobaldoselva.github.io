    <!-- ============ MODEL ============ -->
    <section class="model-band texture-dots" aria-labelledby="model-title">
      <div class="container">
        <div class="reveal" style="text-align:center;">
          <span class="kicker">{{ model.kicker }}</span>
          <h2 class="section-title" id="model-title">{{ model.title }}</h2>
          <p class="section-sub" style="margin: 0 auto;">
            {{ model.subtitle }}
          </p>
        </div>

        <div class="loop reveal">
          {%- for step in model.steps %}
          <div class="loop-step">
            <div class="loop-emoji" aria-hidden="true">{{ ic.emojiIcon(step.emoji) }}</div>
            <h3>{{ step.title }}</h3>
            <p>{{ step.desc }}</p>
          </div>
          {%- if not loop.last %}<div class="loop-arrow" aria-hidden="true">{{ model.loopArrow }}</div>{% endif %}
          {%- endfor %}
        </div>

        {%- if model.belt.words and model.belt.words.length %}
        <div class="conveyor reveal" aria-hidden="true">
          <div class="belt-track">
            {% for word in model.belt.words | storyRepeat(model.belt.repeats) %}<span class="belt-pack">{{ word }}</span>{% endfor %}
          </div>
        </div>
        {%- endif %}

        <div class="model-visual reveal">
          {%- set vsrc = model.video.src | storyVideo %}
          {%- if vsrc %}
          {%- set vposter = model.video.poster | imageInfo %}
          <figure class="model-photo">
            <video class="model-video" src="{{ vsrc }}"{% if vposter.src %} poster="{{ vposter.src }}"{% endif %}
                   muted playsinline preload="metadata"{% if vposter.width and vposter.height %} width="{{ vposter.width }}" height="{{ vposter.height }}"{% endif %} data-autoplay
                   aria-label="{{ model.video.label }}"></video>
          </figure>
          {%- endif %}

          {%- if model.receipt %}
          <aside class="receipt" aria-label="{{ model.receipt.ariaLabel }}">
            <p class="r-brand">{{ model.receipt.brand }}<span class="brand-period">.</span></p>
            <p class="r-meta">{{ model.receipt.meta }}</p>
            {%- for row in model.receipt.rows %}
            <div class="r-row"><span>{{ row.label }}</span><span>{{ row.value }}</span></div>
            {%- endfor %}
            <div class="r-row r-total"><span>{{ model.receipt.total.label }}</span><span>{{ model.receipt.total.value }}</span></div>
            <p class="r-paid">{{ model.receipt.paid }}</p>
            <div class="r-code" aria-hidden="true"></div>
            <p class="r-script">{{ model.receipt.script }}</p>
          </aside>
          {%- endif %}
        </div>
      </div>
    </section>
