    <!-- ============ PARTNERS ============ -->
    <section id="partners" aria-labelledby="partners-title"{% cms blockRef, blockKind %}>
      <div class="container">
        <div class="reveal">
          <span class="kicker"{% cms "partners.kicker", "text" %}>{{ partners.kicker }}</span>
          <h2 class="section-title" id="partners-title"{% cms "partners.title", "text" %}>{{ partners.title | safeTitle | safe }}</h2>
          <p class="section-sub"{% cms "partners.subtitle", "longtext" %}>
            {{ partners.subtitle }}
          </p>
        </div>

        <div class="partner-grid">
          {%- for slot in partners.slots %}
          {%- if slot.founding %}
          <div class="p-slot founding reveal"{% cms "partners.slots." + loop.index0, "item" %}>
            {%- if partners.reservedStamp %}
            <span class="stamp"{% cms "partners.reservedStamp", "text" %}>{{ partners.reservedStamp }}</span>
            {%- endif %}
            <span class="slot-logo"{% cms "partners.slots." + loop.index0 + ".logoText", "text" %}>{{ slot.logoText }}</span>
            <small{% cms "partners.slots." + loop.index0 + ".category", "text" %}>{{ slot.category }}</small>
          </div>
          {%- else %}
          <div class="p-slot reveal"{% cms "partners.slots." + loop.index0, "item" %}><span class="slot-logo"{% cms "partners.slots." + loop.index0 + ".logoText", "text" %}>{{ slot.logoText }}</span><small{% cms "partners.slots." + loop.index0 + ".category", "text" %}>{{ slot.category }}</small></div>
          {%- endif %}
          {%- endfor %}
        </div>

        {%- if homepage | sectionEnabled("brands") %}
        <p class="reveal" style="margin-top: 2rem; text-align: center;">
          <a href="#brands" class="btn btn-primary"{% cms "partners.ctaButton", "text" %}>{{ partners.ctaButton }}</a>
        </p>
        {%- endif %}
      </div>
    </section>
