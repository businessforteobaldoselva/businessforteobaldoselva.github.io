    <!-- ============ PROBLEM ============ -->
    <section id="problem" aria-labelledby="problem-title">
      <div class="container">
        <div class="reveal">
          <span class="kicker">{{ problem.kicker }}</span>
          <h2 class="section-title" id="problem-title">{{ problem.title | safeTitle | safe }}</h2>
          <p class="section-sub">
            {{ problem.subtitle }}
          </p>
        </div>

        {%- if problem.manifesto %}
        <div class="manifesto-duo reveal">
          <p class="manifesto" id="manifesto">{{ problem.manifesto }}</p>
          <figure class="manifesto-photo" aria-hidden="false">
            <picture><source type="image/webp" srcset="/images/story-3-get-480.webp 480w, /images/story-3-get.webp 1200w" sizes="(max-width: 800px) 60vw, 340px" /><img src="/images/story-3-get.jpg" width="764" height="896" loading="lazy" alt="A wrapped pack with an orange band waiting in the COVERED dispenser tray — the answer on the wall" /></picture>
          </figure>
        </div>
        {%- endif %}

        <div class="stats-grid">
          {%- for stat in problem.stats %}
          <div class="stat-card reveal">
            <div class="stat-num"><span class="count" data-target="{{ stat.number }}">{{ stat.number }}</span>%</div>
            <p class="stat-label">{{ stat.label }}</p>
          </div>
          {%- endfor %}
        </div>

        <p class="stats-source reveal">Source: <a href="{{ problem.sourceUrl | safeUrl }}" target="_blank" rel="noopener">{{ problem.sourceText }}</a>.</p>

        <div class="photo-strip">
          {%- for photo in problem.photos %}
          <figure class="polaroid reveal" style="--tilt: {{ photo.tilt }};">
            <picture><source type="image/webp" srcset="{{ photo.src | replace('.jpg', '-480.webp') }} 480w, {{ photo.src | replace('.jpg', '.webp') }} 1200w" sizes="(max-width: 780px) 92vw, 420px" /><img src="{{ photo.src }}" width="{{ photo.width }}" height="{{ photo.height }}" loading="lazy"
                 alt="{{ photo.alt }}" /></picture>
            <figcaption>{{ photo.caption }}</figcaption>
          </figure>
          {%- endfor %}
        </div>
      </div>
    </section>
