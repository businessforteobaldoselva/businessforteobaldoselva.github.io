{% import "forms/enquiry-form.njk" as ef %}
{% import "picture.njk" as pic %}
    <!-- ============ FOR VENUES ============ -->
    <section id="venues" aria-labelledby="venues-title">
      <div class="container">
        <div class="reveal">
          <span class="pilot-ribbon">{{ venues.ribbon }}</span>
          <span class="kicker" style="display:block;">{{ venues.kicker }}</span>
          <h2 class="section-title" id="venues-title">{{ venues.title | safeTitle | safe }}</h2>
          <p class="section-sub">
            {{ venues.subtitle }}
          </p>
        </div>

        <div class="cols-2">
          <div class="list-card reveal">
            <h3>{{ ic.emojiIcon(venues.weHandle.icon) }} {{ venues.weHandle.title }}</h3>
            <ul>
              {%- for item in venues.weHandle.items %}
              <li>{{ item }}</li>
              {%- endfor %}
            </ul>
          </div>
          <div class="list-card wants reveal">
            <h3>{{ ic.emojiIcon(venues.youProvide.icon) }} {{ venues.youProvide.title }}</h3>
            <ul>
              {%- for item in venues.youProvide.items %}
              <li>{{ item }}</li>
              {%- endfor %}
            </ul>
          </div>
        </div>

        {%- if venues.photos and venues.photos.length %}
        <div class="photo-strip">
          {%- for photo in venues.photos %}
          {%- set im = photo.src | imageInfo %}
          {%- if im.src %}
          <figure class="polaroid reveal" style="--tilt: {{ photo.tilt | safeTilt }};">
            {{ pic.picture(im, photo.alt, photo.decorative, "(max-width: 780px) 92vw, 420px") }}
            <figcaption>{{ photo.caption }}</figcaption>
          </figure>
          {%- endif %}
          {%- endfor %}
        </div>
        {%- endif %}

        <div class="form-card light-form reveal">
          <h3>{{ venues.form.heading }}</h3>
          {{ ef.enquiryForm("venueForm", "venue-enquiry", venues.form, "vf") }}
        </div>
      </div>
    </section>
