/* CMS theme overrides (src/_data/theme.json). Every value passes through the
   safeColor filter, so only a well-formed hex colour can reach this block —
   anything malformed falls back to the shipped default. The defaults below
   mirror :root in site-styles.css exactly, so with an untouched theme.json
   this block re-states the palette and the rendered site is unchanged.
   The logo colours (--logo-green/sage/orange) are fixed brand artwork and
   are deliberately not themeable. */
:root {
  --paper: {{ theme.paper | safeColor("#FFF8EC") }};
  --paper-2: {{ theme.paper2 | safeColor("#FFEFDA") }};
  --band-grass: {{ theme.bandGrass | safeColor("#EEF4CC") }};
  --band-lav: {{ theme.bandLav | safeColor("#FFECD3") }};
  --band-rosa: {{ theme.bandRosa | safeColor("#FBE3C6") }};
  --peach: {{ theme.peach | safeColor("#FBD9B3") }};
  --ink: {{ theme.ink | safeColor("#2F4D19") }};
  --ink-deep: {{ theme.inkDeep | safeColor("#1C3110") }};
  --ink-soft: {{ theme.inkSoft | safeColor("#3D5A28") }};
  --muted: {{ theme.muted | safeColor("#566B42") }};
  --red: {{ theme.accent | safeColor("#FC7130") }};
  --red-deep: {{ theme.accentDeep | safeColor("#BB4A12") }};
  --red-dark: {{ theme.accentDark | safeColor("#963A0B") }};
  --kicker-band: {{ theme.kickerBand | safeColor("#963A0B") }};
  --green: {{ theme.grass | safeColor("#6E8B2E") }};
  --green-dark: {{ theme.grassDark | safeColor("#4C6720") }};
  --sage: {{ theme.lavender | safeColor("#E2F099") }};
  /* hairline + shadow derive from the ink colour (defaults: rgba(47, 77, 25, …)) */
  --line: {{ theme.ink | safeColor("#2F4D19") | hexToRgba(0.20) }};
  --shadow: 0 10px 30px {{ theme.ink | safeColor("#2F4D19") | hexToRgba(0.12) }};
}
