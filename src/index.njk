{% import "icons.njk" as ic %}{% set chromeHome = true %}{% set shareImg = site.shareImage | imageInfo %}{% set canon = site.canonicalUrl | seoCanonical("https://coveredaccess.com/") %}{% set shareSrc = (shareImg.src if shareImg.src.charAt(0) == "/" else "/" + shareImg.src) if shareImg.src else "" %}<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="{{ theme.paper2 | safeColor("#FFEFDA") }}" />
  <script>
    /* Netlify Identity emails (invites, password recovery) link to the site
       root with a token in the hash — forward them to the CMS login page. */
    (function () {
      var h = document.location.hash;
      if (h && /(invite_token|recovery_token|confirmation_token|email_change_token)=/.test(h)) {
        document.location.replace("/cms/" + h);
      }
    })();
  </script>
  <title>{{ site.pageTitle }}</title>
  <meta name="description" content="{{ site.metaDescription }}" />
  {% if site.hideFromSearch === true %}<meta name="robots" content="noindex, follow" />{% endif %}

  <!-- Open Graph -->
  <meta property="og:title" content="{{ site.socialTitle or site.pageTitle }}" />
  <meta property="og:description" content="{{ site.ogDescription }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ canon }}" />
  <meta property="og:site_name" content="COVERED" />
  {% if shareSrc %}<meta property="og:image" content="https://coveredaccess.com{{ shareSrc }}" />
  {% if shareImg.width and shareImg.height %}<meta property="og:image:width" content="{{ shareImg.width }}" />
  <meta property="og:image:height" content="{{ shareImg.height }}" />{% endif %}{% if site.shareImageAlt %}
  <meta property="og:image:alt" content="{{ site.shareImageAlt }}" />
  <meta name="twitter:image:alt" content="{{ site.shareImageAlt }}" />{% endif %}{% endif %}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href="{{ canon }}" />
  <link rel="alternate" type="application/atom+xml" title="{{ site.feedTitle }}" href="/feed.xml" />

  <!-- Favicon: stamp-style C -->
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Cpath fill='%2394AB8D' d='M31 8C36.5 17 44 22.5 44 33A13 13 0 1 1 18 33C18 22.5 25.5 17 31 8Z'/%3E%3Ccircle cx='15' cy='15' r='11' fill='%23F0A35C'/%3E%3C/svg%3E" />

  <link rel="preload" href="/fonts/motor-regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/open-sauce-one-400.woff2" as="font" type="font/woff2" crossorigin />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://coveredaccess.com/#org",
        "name": "COVERED",
        "url": "https://coveredaccess.com/",
        "email": {{ site.contactEmail | dump | replace("<", "\\u003c") | safe }},
        "slogan": {{ site.schemaSlogan | dump | replace("<", "\\u003c") | safe }},
        "description": {{ site.schemaDescription | dump | replace("<", "\\u003c") | safe }},
        "foundingLocation": { "@type": "Place", "name": {{ site.schemaPlace | dump | replace("<", "\\u003c") | safe }} },
        "areaServed": "GB"{% if shareSrc %},
        "logo": "https://coveredaccess.com{{ shareSrc }}"{% endif %}
      },
      {
        "@type": "WebSite",
        "@id": "https://coveredaccess.com/#website",
        "url": "https://coveredaccess.com/",
        "name": {{ site.pageTitle | dump | replace("<", "\\u003c") | safe }},
        "publisher": { "@id": "https://coveredaccess.com/#org" },
        "inLanguage": "en-GB",
        "datePublished": "2026-06-28",
        "dateModified": "2026-07-13"
      }{% if (homepage | sectionEnabled("faq")) and faq.items and faq.items.length %},
      {
        "@type": "FAQPage",
        "@id": "https://coveredaccess.com/#faqpage",
        "mainEntity": [
          {%- for item in faq.items %}
          {
            "@type": "Question",
            "name": {{ item.q | dump | replace("<", "\\u003c") | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | replace("<", "\\u003c") | safe }} }
          }{% if not loop.last %},{% endif %}
          {%- endfor %}
        ]
      }{% endif %}
    ]
  }
  </script>

  <style>
{% include "site-styles.css" %}
{% include "theme-vars.njk" %}  </style>
  <noscript><style>.reveal { opacity: 1; transform: none; } .faq-a { max-height: none !important; } .faq-a[hidden] { display: block; }</style></noscript>
</head>
{#- Animation controls (src/_data/motion.json) → body classes, so CSS-only
    motion (marquee, conveyor, floaty…) obeys the CMS without JavaScript.
    With default settings no class is emitted and the page is unchanged. -#}
{%- set motionClasses = "" %}
{%- if motion.enabled === false %}{% set motionClasses = motionClasses + " motion-off" %}{% endif %}
{%- if motion.speed == "slower" %}{% set motionClasses = motionClasses + " m-speed-slower" %}{% elif motion.speed == "faster" %}{% set motionClasses = motionClasses + " m-speed-faster" %}{% endif %}
{%- if motion.reveal == "fade" %}{% set motionClasses = motionClasses + " reveal-fade" %}{% elif motion.reveal == "off" %}{% set motionClasses = motionClasses + " reveal-off" %}{% endif %}
{%- if motion.floatingHearts === false %}{% set motionClasses = motionClasses + " no-floaty" %}{% endif %}
{%- if motion.marquee === false %}{% set motionClasses = motionClasses + " no-marquee" %}{% endif %}
{%- if motion.conveyor === false %}{% set motionClasses = motionClasses + " no-conveyor" %}{% endif %}
{%- if motion.scrollProgress === false %}{% set motionClasses = motionClasses + " no-progress" %}{% endif %}
<body{% if motionClasses %} class="{{ motionClasses | trim }}"{% endif %}{% cms "theme.paper", "color", { cssvar: "--paper" } %}>

  {% include "chrome/skip-link.njk" %}

  <div id="progress" role="presentation"{% cms "motion.scrollProgress", "toggle" %}></div>

  {% include "chrome/nav.njk" %}

  <main id="top">

    {%- set builtinSections = ["hero", "marquee", "problem", "model", "how", "brands", "partners", "venues", "locations", "vision", "faq", "cta"] %}
    {#- Hiding the hero would leave the page without an h1 — fall back to a
        visually hidden main heading for search engines and screen readers. -#}
    {%- if not (homepage | sectionEnabled("hero")) %}
    <h1 class="visually-hidden">{{ site.pageTitle }}</h1>
    {%- endif %}
    {#- Built-in sections are singletons: only the first copy of each type is
        rendered. A duplicate would emit duplicate DOM ids and dead controls,
        because the inline JS only wires the first match. -#}
    {%- set renderedBuiltins = [] %}
    {%- for s in homepage.sections %}
      {%- if s.enabled !== false %}
        {%- set sectionData = s %}
        {%- set block = s %}
        {%- set blockRef = "homepage.sections." + loop.index0 %}
        {%- set blockKind = "section" %}
        {%- if s.type in builtinSections %}
          {%- if s.type not in renderedBuiltins %}
            {%- set _ = renderedBuiltins.push(s.type) %}
{% include "sections/" + s.type + ".njk" %}
          {%- endif %}
        {%- elif s.type == "textBlock" %}
{% include "blocks/text.njk" %}
        {%- elif s.type == "imageTextBlock" %}
{% include "blocks/imageText.njk" %}
        {%- elif s.type == "statsBlock" %}
{% include "blocks/stats.njk" %}
        {%- elif s.type == "bannerBlock" %}
{% include "blocks/banner.njk" %}
        {%- elif s.type == "faqBlock" %}
{% include "blocks/faq.njk" %}
        {%- endif %}
      {%- endif %}
    {%- endfor %}

  </main>

  <!-- ============ FOOTER ============ -->
  {% include "chrome/footer.njk" %}

  <script>window.COVERED_MOTION = {{ motion | dump | replace("<", "\\u003c") | safe }};</script>
  <script>
    /* Brand period: colour the final full stop of display lines.
       The voice writes in short declaratives; the logo ends in an orange dot.
       Progressive enhancement — with JS off the text is simply unstyled. */
    (function () {
      document.querySelectorAll(".section-title, .hero h1, .cta-banner h2, .story-card figcaption strong").forEach(function (el) {
        if (el.querySelector(".brand-period")) return;
        var walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null);
        var lastText = null, node;
        while ((node = walker.nextNode())) { if (node.textContent.trim()) lastText = node; }
        if (!lastText) return;
        if (lastText.textContent.replace(/\s+$/, "").slice(-1) !== ".") return;
        var idx = lastText.textContent.lastIndexOf(".");
        var tail = lastText.splitText(idx);
        tail.textContent = tail.textContent.slice(1);
        var dot = document.createElement("span");
        dot.className = "brand-period";
        dot.textContent = ".";
        lastText.parentNode.insertBefore(dot, tail);
      });
    })();
  </script>
  <script>
    (function () {
      "use strict";
      var M = window.COVERED_MOTION || {};
      var prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      /* The CMS master switch behaves like an OS "reduce motion" request —
         but the visitor's OS preference always wins, even when the CMS has
         animations switched ON. */
      var reduced = prefersReducedMotion || M.enabled === false;

{% include "scripts/page-chrome.njk" %}
{% include "scripts/hero-motion.njk" %}
{% include "scripts/counters.njk" %}
{% include "scripts/demo.njk" %}
{% include "scripts/map.njk" %}
{% include "scripts/faq.njk" %}
{% include "scripts/forms.njk" %}
{% include "scripts/scrollspy.njk" %}
{% include "scripts/notify.njk" %}
    })();
  </script>
</body>
</html>
