{% import "icons.njk" as ic %}<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="{{ theme.paper2 | safeColor("#FFEFDA") }}" />
  <script>
    /* Netlify Identity emails (invites, password recovery) link to the site
       root with a token in the hash — forward them to the CMS login page. */
    (function () {
      var h = document.location.hash;
      if (h && /(invite_token|recovery_token|confirmation_token|email_change_token)=/.test(h)) {
        document.location.replace("/cms/" + h);
      }
    })();
  </script>
  <title>{{ site.pageTitle }}</title>
  <meta name="description" content="{{ site.metaDescription }}" />

  <!-- Open Graph -->
  <meta property="og:title" content="{{ site.pageTitle }}" />
  <meta property="og:description" content="{{ site.ogDescription }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://coveredaccess.com/" />
  <meta property="og:site_name" content="COVERED" />
  <meta property="og:image" content="https://coveredaccess.com/images/covered-og.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href="https://coveredaccess.com/" />
  <link rel="alternate" type="application/atom+xml" title="COVERED updates" href="/feed.xml" />

  <!-- Favicon: stamp-style C -->
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Cpath fill='%2394AB8D' d='M31 8C36.5 17 44 22.5 44 33A13 13 0 1 1 18 33C18 22.5 25.5 17 31 8Z'/%3E%3Ccircle cx='15' cy='15' r='11' fill='%23F0A35C'/%3E%3C/svg%3E" />

  <link rel="preload" href="/fonts/motor-regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/open-sauce-one-400.woff2" as="font" type="font/woff2" crossorigin />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://coveredaccess.com/#org",
        "name": "COVERED",
        "url": "https://coveredaccess.com/",
        "email": "{{ site.contactEmail }}",
        "slogan": "Free Period Products, Paid for by Advertising. We got you covered.",
        "description": "COVERED is a UK social enterprise that installs smart wall-mounted dispensers giving out free, plastic-free period products, funded entirely by brands advertising on the dispensers' 32-inch digital screens.",
        "foundingLocation": { "@type": "Place", "name": "Exeter, United Kingdom" },
        "areaServed": "GB",
        "logo": "https://coveredaccess.com/images/covered-og.jpg"
      },
      {
        "@type": "WebSite",
        "@id": "https://coveredaccess.com/#website",
        "url": "https://coveredaccess.com/",
        "name": "{{ site.pageTitle }}",
        "publisher": { "@id": "https://coveredaccess.com/#org" },
        "inLanguage": "en-GB",
        "datePublished": "2026-06-28",
        "dateModified": "2026-07-13"
      }{% if (homepage | sectionEnabled("faq")) and faq.items and faq.items.length %},
      {
        "@type": "FAQPage",
        "@id": "https://coveredaccess.com/#faqpage",
        "mainEntity": [
          {%- for item in faq.items %}
          {
            "@type": "Question",
            "name": {{ item.q | dump | replace("<", "\\u003c") | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | replace("<", "\\u003c") | safe }} }
          }{% if not loop.last %},{% endif %}
          {%- endfor %}
        ]
      }{% endif %}
    ]
  }
  </script>

  <style>
{% include "site-styles.css" %}
{% include "theme-vars.njk" %}  </style>
  <noscript><style>.reveal { opacity: 1; transform: none; } .faq-a { max-height: none !important; } .faq-a[hidden] { display: block; }</style></noscript>
</head>
{#- Animation controls (src/_data/motion.json) → body classes, so CSS-only
    motion (marquee, conveyor, floaty…) obeys the CMS without JavaScript.
    With default settings no class is emitted and the page is unchanged. -#}
{%- set motionClasses = "" %}
{%- if motion.enabled === false %}{% set motionClasses = motionClasses + " motion-off" %}{% endif %}
{%- if motion.speed == "slower" %}{% set motionClasses = motionClasses + " m-speed-slower" %}{% elif motion.speed == "faster" %}{% set motionClasses = motionClasses + " m-speed-faster" %}{% endif %}
{%- if motion.reveal == "fade" %}{% set motionClasses = motionClasses + " reveal-fade" %}{% elif motion.reveal == "off" %}{% set motionClasses = motionClasses + " reveal-off" %}{% endif %}
{%- if motion.floatingHearts === false %}{% set motionClasses = motionClasses + " no-floaty" %}{% endif %}
{%- if motion.marquee === false %}{% set motionClasses = motionClasses + " no-marquee" %}{% endif %}
{%- if motion.conveyor === false %}{% set motionClasses = motionClasses + " no-conveyor" %}{% endif %}
{%- if motion.scrollProgress === false %}{% set motionClasses = motionClasses + " no-progress" %}{% endif %}
<body{% if motionClasses %} class="{{ motionClasses | trim }}"{% endif %}>

  <a class="skip-link" href="#top">Skip to content</a>

  <div id="progress" role="presentation"></div>

  <header>
    <div class="container nav">
      <a href="#top" class="logo" aria-label="COVERED home">
        <span class="logo-mark" aria-hidden="true"><svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#94AB8D" d="M31 8C36.5 17 44 22.5 44 33A13 13 0 1 1 18 33C18 22.5 25.5 17 31 8Z"/><circle cx="15" cy="15" r="11" fill="#F0A35C"/></svg></span>
        COVERED<span class="logo-dot">.</span>
      </a>
      <button class="burger" aria-label="Toggle menu" aria-expanded="false" aria-controls="navLinks">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav-links" id="navLinks">
        {% if homepage | sectionEnabled("how") %}<li><a href="#how">How it works</a></li>{% endif %}
        {% if homepage | sectionEnabled("partners") %}<li><a href="#partners">Partners</a></li>{% endif %}
        {% if homepage | sectionEnabled("venues") %}<li><a href="#venues">For venues</a></li>{% endif %}
        {% if homepage | sectionEnabled("locations") %}<li><a href="#locations">Locations</a></li>{% endif %}
        <li><a href="/about/">About</a></li>
        {% if homepage | sectionEnabled("faq") %}<li><a href="#faq">FAQ</a></li>{% endif %}
        {% if homepage | sectionEnabled("brands") %}<li><a href="#brands" class="btn btn-primary">Advertise with us</a></li>{% endif %}
      </ul>
    </div>
  </header>

  <main id="top">

    {%- set builtinSections = ["hero", "marquee", "problem", "model", "how", "brands", "partners", "venues", "locations", "vision", "faq", "cta"] %}
    {#- Hiding the hero would leave the page without an h1 — fall back to a
        visually hidden main heading for search engines and screen readers. -#}
    {%- if not (homepage | sectionEnabled("hero")) %}
    <h1 class="visually-hidden">{{ site.pageTitle }}</h1>
    {%- endif %}
    {#- Built-in sections are singletons: only the first copy of each type is
        rendered. A duplicate would emit duplicate DOM ids and dead controls,
        because the inline JS only wires the first match. -#}
    {%- set renderedBuiltins = [] %}
    {%- for s in homepage.sections %}
      {%- if s.enabled !== false %}
        {%- set sectionData = s %}
        {%- set block = s %}
        {%- if s.type in builtinSections %}
          {%- if s.type not in renderedBuiltins %}
            {%- set _ = renderedBuiltins.push(s.type) %}
{% include "sections/" + s.type + ".njk" %}
          {%- endif %}
        {%- elif s.type == "textBlock" %}
{% include "blocks/text.njk" %}
        {%- elif s.type == "imageTextBlock" %}
{% include "blocks/imageText.njk" %}
        {%- elif s.type == "statsBlock" %}
{% include "blocks/stats.njk" %}
        {%- elif s.type == "bannerBlock" %}
{% include "blocks/banner.njk" %}
        {%- elif s.type == "faqBlock" %}
{% include "blocks/faq.njk" %}
        {%- endif %}
      {%- endif %}
    {%- endfor %}

  </main>

  <!-- ============ FOOTER ============ -->
